{
  "name": "@resolid/utils",
  "version": "1.7.1",
  "description": "Common utils",
  "keywords": [
    "javascript",
    "nodejs",
    "resolid",
    "typescript"
  ],
  "homepage": "https://www.resolid.tech",
  "license": "MIT",
  "author": "Huijie Wei",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/resolid/utils.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./date": {
      "types": "./dist/date.d.mts",
      "import": "./dist/date.mjs"
    },
    "./http": {
      "types": "./dist/http.d.mts",
      "import": "./dist/http.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "changeset": "changeset",
    "build": "tsdown",
    "format": "oxfmt",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "get-locale-data": "node scripts/get-locale-data.js"
  },
  "dependencies": {
    "nanoid": "^6.0.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@resolid/config": "^6.3.1",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "srvx": "^0.12.7",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "undici": "^8.10.0"
  },
  "peerDependenciesMeta": {
    "undici": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.22.0 || >=24"
  },
  "packageManager": "pnpm@11.23.0"
}
